@model EventManagement.Mvc.Models.ViewModels.OrganiserViewModel

@{
    ViewData["Title"] = "Edit Organiser";
}

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header">
            <h3>Edit Organiser</h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  asp-route-id="@Model.OrganiserId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="OrganiserId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Organiser ID</label>
                    <input value="@Model.OrganiserId"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">User ID</label>
                    <input value="@Model.UserId"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="OrganisationName"
                           class="form-label">
                        Organisation Name
                    </label>

                    <input asp-for="OrganisationName"
                           class="form-control" />

                    <span asp-validation-for="OrganisationName"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
