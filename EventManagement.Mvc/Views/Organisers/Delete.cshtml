@model EventManagement.Mvc.Models.ViewModels.OrganiserViewModel

@{
    ViewData["Title"] = "Delete Organiser";
}

<div class="container mt-4">

    <div class="card shadow-sm border-danger">

        <div class="card-header bg-danger text-white">
            <h3>Delete Organiser</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this organiser?
                This action cannot be undone.
            </div>

            <dl class="row">

                <dt class="col-sm-3">Organiser ID</dt>
                <dd class="col-sm-9">@Model.OrganiserId</dd>

                <dt class="col-sm-3">Organisation</dt>
                <dd class="col-sm-9">@Model.OrganisationName</dd>

                <dt class="col-sm-3">Contact Person</dt>
                <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.OrganiserId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

