<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/EventManagement.Mvc.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar sticky-top">
            <div class="container">

                <a class="navbar-brand raceday-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-mark">RD</span>
                    <span>RaceDay</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Organiser"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Organisers"
                                       asp-action="Dashboard">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Organisers"
                                       asp-action="Index">
                                        Organiser Management
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Participant"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="ParticipantDashboard"
                                       asp-action="Index">
                                        My Dashboard
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Privacy">
                                    Privacy
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text text-white">
                                Welcome, @User.Identity.Name
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm px-3">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm px-3"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>

                            <a class="btn btn-raceday btn-sm px-3"
                               asp-controller="Account"
                               asp-action="Register">
                                Create Account
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <footer class="raceday-footer mt-auto">
        <div class="container py-4">
            <div class="row align-items-center gy-3">

                <div class="col-md-6">
                    <div class="footer-brand">RaceDay</div>
                    <small>Making every event count.</small>
                </div>

                <div class="col-md-6 text-md-end">
                    <small>
                        &copy; @DateTime.Now.Year RaceDay.
                        All rights reserved.
                    </small>

                    <div>
                        <a asp-controller="Home"
                           asp-action="Privacy">
                            Privacy Policy
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>