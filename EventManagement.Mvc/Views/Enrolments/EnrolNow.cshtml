@model EventManagement.Mvc.Models.ViewModels.EnrolmentCreateViewModel

@{
    ViewData["Title"] = "Enrol in Event";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Enrol in Event</h3>
                </div>

                <div class="card-body">

                    <h5 class="mb-3">
                        @Model.EventName
                    </h5>

                    <p class="text-muted">
                        Select your preferred event category below.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.PageError))
                    {
                        <div class="alert alert-danger">
                            @Model.PageError
                        </div>
                    }

                    @if (Model.Categories.Any())
                    {
                        <form asp-controller="Enrolments"
                              asp-action="EnrolNow"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   asp-for="EventId" />

                            <div class="mb-3">

                                <label asp-for="CategoryId"
                                       class="form-label">
                                    Select Event Category
                                </label>

                                <select asp-for="CategoryId"
                                        class="form-select">

                                    <option value="0">
                                        -- Select a category --
                                    </option>

                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryId">
                                            @category.CategoryName -
                                            R @category.EntryFee.ToString("N2") -
                                            @category.AvailableEntries spaces available
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="alert alert-info">
                                <strong>Important:</strong>
                                Your enrolment will be checked for duplicate
                                registrations and category availability.
                            </div>

                            <div class="d-flex justify-content-between">

                                <a asp-controller="ParticipantDashboard"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn btn-primary">
                                    Enrol Now
                                </button>

                            </div>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            No categories currently have available spaces
                            for this event.
                        </div>

                        <a asp-controller="ParticipantDashboard"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Back to Dashboard
                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

