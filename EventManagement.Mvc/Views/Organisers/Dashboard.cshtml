@model EventManagement.Mvc.Models.OrganiserDashboardViewModel

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">

    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Organiser Dashboard</h2>
            <p class="text-muted">
                Welcome to @Model.OrganisationName
            </p>
        </div>

        <a asp-controller="Organisers"
           asp-action="Index"
           class="btn btn-outline-primary">
            Manage Organisers
        </a>
    </div>

    <!-- Error Message -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Summary Cards -->
    <div class="row mb-4">

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Events</h6>
                    <h2>@Model.TotalEvents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Enrolments</h6>
                    <h2>@Model.TotalEnrolments</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Results Management -->
    <div class="row mb-4">

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Results Management
                    </h5>

                    <p class="card-text text-muted">
                        Capture and manage participant race results,
                        finishing positions and completion times.
                    </p>

                    <a asp-controller="OrganiserResults"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Results
                    </a>

                </div>
            </div>
        </div>

    </div>

    <!-- Upcoming Events -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Upcoming Events</h5>
        </div>

        <div class="card-body table-responsive">

            @if (Model.UpcomingEvents.Any())
            {
                <table class="table table-striped table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Banner</th>
                            <th>Event</th>
                            <th>Description</th>
                            <th>Date</th>
                            <th>Location</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.UpcomingEvents)
                        {
                            <tr>
                                <td>
                                    <img src="@Url.Action("Banner", "Organisers", new { id = item.EventId })"
                                         alt="@item.EventName banner"
                                         class="img-thumbnail"
                                         style="width: 150px; height: 90px; object-fit: cover;"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="bg-light text-muted rounded"
                                         style="display:none; width:150px; height:90px; align-items:center; justify-content:center; font-size:12px;">
                                        No banner uploaded
                                    </div>
                                </td>

                                <td>
                                    <strong>@item.EventName</strong>
                                </td>

                                <td>
                                    @item.Description
                                </td>

                                <td>
                                    @item.EventDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @item.Location
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            }
            else
            {
                <p class="text-muted mb-0">
                    No upcoming events available.
                </p>
            }

        </div>
    </div>

    <!-- Recent Enrolments -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Recent Enrolments</h5>
        </div>

        <div class="card-body table-responsive">

            @if (Model.RecentEnrolments.Any())
            {
                <table class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Event ID</th>
                            <th>Enrolled At</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.RecentEnrolments)
                        {
                            <tr>
                                <td>
                                    @item.ParticipantName
                                </td>

                                <td>
                                    @item.EventId
                                </td>

                                <td>
                                    @item.EnrolledAt.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="badge bg-info">
                                        @item.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            }
            else
            {
                <p class="text-muted mb-0">
                    No recent enrolments available.
                </p>
            }

        </div>
    </div>

</div>
