@model IEnumerable<EventManagement.Mvc.Models.ViewModels.OrganiserViewModel>

@{
    ViewData["Title"] = "Organiser Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Organiser Management</h2>
            <p class="text-muted">
                Manage registered event organisers.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Organisers"
               asp-action="Dashboard"
               class="btn btn-outline-primary">
                Dashboard
            </a>

            <a asp-action="Create" class="btn btn-primary">
                Register Organiser
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Organiser ID</th>
                            <th>Organisation</th>
                            <th>Contact Person</th>
                            <th>Email</th>
                            <th>User ID</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var organiser in Model)
                        {
                            <tr>
                                <td>@organiser.OrganiserId</td>

                                <td class="fw-semibold">
                                    @organiser.OrganisationName
                                </td>

                                <td>
                                    @organiser.FirstName @organiser.LastName
                                </td>

                                <td>@organiser.Email</td>

                                <td>@organiser.UserId</td>

                                <td>
                                    <div class="btn-group btn-group-sm">

                                        <a asp-action="Details"
                                           asp-route-id="@organiser.OrganiserId"
                                           class="btn btn-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@organiser.OrganiserId"
                                           class="btn btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@organiser.OrganiserId"
                                           class="btn btn-danger">
                                            Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No organisers have been registered yet.
        </div>
    }

</div>
